<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_classic"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="8dp">

    <TextView
        android:id="@+id/widget_rank_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:text="列兵"
        android:textColor="@color/widget_classic_text_primary"
        android:textSize="10sp"
        android:textStyle="bold"
        android:letterSpacing="0.03" />

    <TextView
        android:id="@+id/widget_streak_days"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center"
        android:includeFontPadding="false"
        android:text="0"
        android:textColor="@color/widget_classic_accent"
        android:textSize="26sp"
        android:textStyle="bold"
        android:fontFeatureSettings="tnum" />

    <TextView
        android:id="@+id/widget_rank_range"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:text="0–3 天"
        android:textColor="@color/widget_classic_text_secondary"
        android:textSize="8sp" />

</LinearLayout>
