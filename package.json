{
  "name": "rigong",
  "version": "1.0.0",
  "description": "365.dev - 日历打卡应用",
  "scripts": {
    "copy-web": "copy-web.bat",
    "sync:icon": "node scripts/sync-icon-from-icons.js",
    "generate:icons": "npm run sync:icon && node node_modules/@capacitor/assets/bin/capacitor-assets generate --android --iconBackgroundColor \"#ffffff\" --iconBackgroundColorDark \"#1a1d23\"",
    "cap:sync": "npm run copy-web && npx cap sync android",
    "cap:open": "npx cap open android",
    "android": "npx cap sync android && npx cap open android",
    "build:apk": "build-apk.bat"
  },
  "capacitor": {
    "platforms": [
      "android"
    ]
  },
  "devDependencies": {
    "@capacitor/android": "^7.2.0",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^7.2.0",
    "@capacitor/core": "^7.2.0"
  },
  "dependencies": {
    "@capacitor/filesystem": "^7.1.8",
    "@capacitor/share": "^7.0.4"
  }
}
